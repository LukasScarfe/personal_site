.hugo_build.lock
resources/

# Hugo build output. Generated by CI (.github/workflows/hugo.yaml) and uploaded as the
# Pages artifact, so it must NOT be tracked: checkout would restore stale files, and
# `hugo` does not delete orphans from its destination, so anything no longer generated
# (renamed slugs, pages set to draft) would keep being published. See --cleanDestinationDir.
public/
